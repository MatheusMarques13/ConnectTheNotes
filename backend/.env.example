# Copy to .env and fill in. NEVER commit the real .env.
MONGO_URL=mongodb://localhost:27017
DB_NAME=connect_the_notes

# Comma-separated list of allowed CORS origins. Pin this to your frontend
# origin in production (a bare "*" disables credentialed CORS).
ALLOWED_ORIGINS=*

# Secret required by POST /api/admin/seed (X-Seed-Token header).
# Leave unset to disable the endpoint entirely.
SEED_TOKEN=
